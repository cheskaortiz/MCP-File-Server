# Copy to .env (never commit .env).
# Folder agents may access. Relative paths resolve from where you start the server.
WORKSPACE_ROOT=./workspace

# Audit log of mutating operations. Keep it outside WORKSPACE_ROOT so agents cannot edit it.
AUDIT_LOG_PATH=./logs/audit.log

# HTTP server configuration (npm run dev:http or npm run start:http).
# static preserves the existing shared-token authentication.
MCP_AUTH_MODE=static
# Generate a strong token using: npm run gen-token
MCP_AUTH_TOKEN=
MCP_HOST=127.0.0.1
MCP_PORT=3000

# Optional comma-separated Host header allow-list.
# Leave blank for local development.
MCP_ALLOWED_HOSTS=

# OAuth settings are required when MCP_AUTH_MODE=oauth or both.
# Use the public HTTPS issuer origin and public MCP resource URL (including /mcp).
MCP_OAUTH_ISSUER_URL=
MCP_OAUTH_RESOURCE_URL=
# Use a password of at least 32 characters for consent.
MCP_OAUTH_OWNER_PASSWORD=
# Absolute path outside WORKSPACE_ROOT; OAuth clients and tokens are persisted here.
MCP_OAUTH_STORAGE_DIR=
