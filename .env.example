# Copy to .env (never commit .env).
# Folder agents may access. Relative paths resolve from where you start the server.
WORKSPACE_ROOT=./workspace

# Audit log of mutating operations. Keep it outside WORKSPACE_ROOT so agents cannot edit it.
AUDIT_LOG_PATH=./logs/audit.log

# HTTP server configuration (npm run dev:http or npm run start:http).
# Generate a strong token using: npm run gen-token
MCP_AUTH_TOKEN=
MCP_HOST=127.0.0.1
MCP_PORT=3000

# Optional comma-separated Host header allow-list.
# Leave blank for local development.
MCP_ALLOWED_HOSTS=
